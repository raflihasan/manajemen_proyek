<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · SIPM Event Kampus</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<% if (user) { %>
<body>
<div class="app-shell">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <span class="brand-icon">◆</span>
      <div>
        <strong>SIPM</strong>
        <small>Event Kampus</small>
      </div>
    </div>
    <nav class="nav">
      <a href="/dashboard" class="<%= currentPath.startsWith('/dashboard') || currentPath === '/' ? 'active' : '' %>">Dashboard</a>
      <a href="/projects" class="<%= currentPath.startsWith('/projects') && !currentPath.includes('/gantt') && !currentPath.includes('/pert') ? 'active' : '' %>">Proyek</a>
      <a href="/tasks" class="<%= currentPath.startsWith('/tasks') ? 'active' : '' %>">Tugas Saya</a>
      <a href="/resources" class="<%= currentPath.startsWith('/resources') ? 'active' : '' %>">Sumber Daya</a>
      <% if (user.role === 'admin') { %>
        <a href="/users" class="<%= currentPath.startsWith('/users') ? 'active' : '' %>">Akun Pengguna</a>
        <a href="/settings" class="<%= currentPath.startsWith('/settings') ? 'active' : '' %>">Pengaturan</a>
      <% } %>
    </nav>
    <div class="sidebar-footer">
      <div class="user-chip">
        <div class="avatar"><%= user.full_name.charAt(0).toUpperCase() %></div>
        <div class="user-meta">
          <strong><%= user.full_name %></strong>
          <small><%= user.role === 'admin' ? 'Admin' : user.role === 'manajer' ? 'Manajer Proyek' : 'Anggota Tim' %></small>
        </div>
      </div>
      <form method="POST" action="/logout"><button class="btn btn-ghost btn-sm" type="submit">Logout</button></form>
    </div>
  </aside>
  <div class="main">
    <header class="topbar">
      <button class="menu-toggle" id="menuToggle" type="button" aria-label="Buka menu">☰</button>
      <h1 class="page-title"><%= title %></h1>
      <div class="topbar-right"><span class="date-chip"><%= today %></span></div>
    </header>
    <main class="content">
      <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="alert alert-<%= flash.type === 'error' ? 'danger' : flash.type %>"><%= flash.text %></div>
      <% } %>
<% } else { %>
<body class="auth-body">
<% } %>
